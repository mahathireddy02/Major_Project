# Campus Mobility Server Environment Variables
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection String (leave blank or use localhost / MongoDB Atlas URI)
# If left blank or local MongoDB is unavailable, mongodb-memory-server will automatically launch
MONGODB_URI=mongodb://127.0.0.1:27017/campus_mobility

# OSRM Routing Service Base URL
OSRM_BASE_URL=https://router.project-osrm.org
VITE_OSRM_URL=https://router.project-osrm.org

# JWT / Secret Key for auth
JWT_SECRET=campus-mobility-hackathon-secret-key-2026

# Configurable Authorized College Domains (comma separated)
AUTHORIZED_COLLEGE_DOMAINS=campus.edu,college.edu,university.ac.in,iit.ac.in,nit.ac.in,campusflow.io

# Dispatcher / Admin Seed Credentials
DISPATCHER_USERNAME=dispatcher@campusflow.io
DISPATCHER_PASSWORD=CampusFlowAdmin2026!

# Routing Constraints
MAX_DETOUR_PERCENT=15
MAX_EXTRA_TIME_MINUTES=5
ROUTE_DEVIATION_THRESHOLD_METERS=150
